# PromptForge 2.0 — environment variables (copy to .env.local)
# Never commit real secrets. Keep server-only values out of NEXT_PUBLIC_*.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only
SUPABASE_SECRET_KEY=
API_KEY_ENCRYPTION_SECRET=

# Optional provider keys (server-side fallback)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=

# API_KEY_ENCRYPTION_SECRET must be a strong random value of at least 32 characters.
# Keep the same value permanently: changing it makes previously stored keys undecryptable.
