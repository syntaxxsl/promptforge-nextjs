{
  "name": "promptforge-2",
  "version": "0.1.0",
  "private": true,
  "description": "PromptForge 2.0 — modular Next.js + TypeScript platform (V1 untouched)",
  "scripts": {
    "dev": "sh ./dev.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/live-api.test.ts'",
    "test:watch": "vitest",
    "test:live": "vitest run lib/ai/__tests__/live-api.test.ts",
    "live:check": "node scripts/live-api-check.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.39.0",
    "clsx": "^2.1.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.1",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.17",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vitest": "5.1.1",
    "@testing-library/dom": "10.4.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6"
  }
}
