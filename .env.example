# PromptForge — ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldur.
# .env.local asla repoya eklenmez.

# --- Supabase (zorunlu) ---
# Project Settings > API ekranından alınır.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sunucu tarafı işlemler için service role anahtarı (asla tarayıcıya gitmemeli).
SUPABASE_SECRET_KEY=

# --- Şifreleme (zorunlu) ---
# AI sağlayıcı anahtarlarını AES-256-GCM ile şifrelemek için kullanılır.
# Üretmek için: openssl rand -hex 32
API_KEY_ENCRYPTION_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://promptforge-nextjs.vercel.app

# --- Cloudflare Turnstile (opsiyonel) ---
# Tanımlanmazsa giriş/kayıt doğrulaması devre dışı kalır.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- E-posta uyarıları (opsiyonel, Resend) ---
RESEND_API_KEY=
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_FROM=PromptForge <onboarding@resend.dev>

# --- Bakım modu ve IP engelleme (opsiyonel) ---
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_TOKEN=
# Virgülle ayrılmış IP listesi: 1.2.3.4,5.6.7.8
BLOCKED_IPS=
# Cloudflare arkasındaysan gerçek IP'yi cf-connecting-ip başlığından oku.
TRUST_CLOUDFLARE_HEADERS=false

# --- Güvenlik olayı bildirimi (opsiyonel) ---
SECURITY_EVENT_TOKEN=

# --- Zamanlanmış sağlık taraması (opsiyonel) ---
CRON_SECRET=

# --- Dağıtık istek sınırlayıcı (opsiyonel, Upstash Redis) ---
# Tanımlanmazsa sayaç bellek içinde tutulur ve her sunucu örneği kendi sayar.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- GitHub dışa aktarma (opsiyonel) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://promptforge-nextjs.vercel.app/api/github/callback

# --- Ekran görüntüsü servisi (opsiyonel, thumbnail) ---
SCREENSHOTONE_ACCESS_KEY=
